# Clerk — create an application at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key

# Convex — run `npx convex dev` to create a deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-frontend-api-url.clerk.accounts.dev

# Optional: development Clerk user ID for npm run db:import:dev.
# DEV_CLERK_USER_ID=user_replace_with_your_development_user_id

# Required for the regional song and binder access; set the same server-only key in the Convex deployment.
# PUBLIC_CATALOG_ACCESS_KEY=replace-with-shared-secret
# Optional local region override, used only after the shared catalog key is configured.
# LOCAL_PUBLIC_CATALOG_COUNTRY=US
